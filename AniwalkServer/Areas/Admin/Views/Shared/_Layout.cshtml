@using AniwalkServer
@{
    var CurrentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var CurrentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
@{
        //共用Head
        await Html.RenderPartialAsync("_SharedLayout.Head");
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AniwalkServer</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="@Shared.Role_Admin" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="@Shared.Role_Admin" asp-controller="Visits" asp-action="ShowVisitsOnList">清單檢視</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="@Shared.Role_Admin" asp-controller="AddNewAnimes" asp-action="Index">檢視新增動畫建議</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="@Shared.Role_Admin" asp-controller="Announcements" asp-action="Index">公告檢視</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="@Shared.Role_Admin" asp-controller="Members" asp-action="Index">會員檢視</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav text-end">
                        <li class="nav-item">
                            <p>歡迎管理員，@User.Identity.Name</p>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light btn btn-primary" asp-area="@Shared.Role_Admin" asp-controller="Login" asp-action="Logout">登出</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (CurrentController == "Visits" && CurrentAction == "ShowVisitsOnMap")
    {
        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AniwalkServer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
