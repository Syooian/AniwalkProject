@using AniwalkServer.DTOs
@using AniwalkServer.Data
@using AniwalkServer.QueryParameters
@model PageDTO<Animes, AnimesParam>

@{
    ViewData[ViewDataKeys.Title] = "動畫清單";
}

<h1>@ViewData[ViewDataKeys.Title] </h1>

<p>
    <a asp-action="Create" asp-route-LastPage="@ViewData[ViewDataKeys.LastPage]" class="btn btn-outline-primary">建立新動畫</a>
</p>

<!--篩選條件-->
@await Html.PartialAsync("_AnimesFilter")
<hr />

<!--列表-->
<div id="ListContainer">
    @await Html.PartialAsync("Index.List");
</div>

@section Scripts {
    <!--呼叫Select2初始化-->
    @await Html.PartialAsync("_Select2")
}