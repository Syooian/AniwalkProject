@model (int Count, List<Announcements>Data)
@{
    ViewData["Title"] = "公告列表";

    int CurrentPage = 1;//當前頁數
}

<h1>
    @ViewData["Title"]
</h1>
<hr />

<p>
    <a asp-action="Create" class="btn btn-outline-primary">新增公告</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td class="col-6">
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SN" class="btn btn-primary">編輯</a> |
                    <a asp-action="Details" asp-route-id="@item.SN" class="btn btn-primary">檢視</a> |
                    <form asp-action="Delete">
                        <input type="hidden" value="@item.SN" name="id" />
                        <input type="submit" value="刪除" class="btn btn-danger" onclick="return confirm('確定刪除公告？')" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            @if (Model.Count > Shared.DefaultPageSize[0])
            {
                var PageCount = Shared.GetPageCount(Model.Count, Shared.DefaultPageSize[0]);

                <td class="text-center">
                    <nav aria-label="...">
                        <ul class="pagination">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">Previous</a>
                            </li>
                            @{
                                for (int a = 1; a <= PageCount; a++)
                                {
                                    <a>@a</a>
                                }
                            }
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item active">
                                <a class="page-link" href="#">2 <span class="sr-only">(current)</span></a>
                            </li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>

                            <li class="page-item">
                                <a class="page-link" href="#">Next</a>
                            </li>
                        </ul>
                    </nav>
                </td>
            }
        </tr>
    </tfoot>
</table>
