@model AniwalkServer.DTOs.PageDTO<Announcements>
@{
    ViewData["Title"] = "公告列表";
}

<h1>
    @ViewData["Title"]
</h1>
<hr />

<p>
    <a asp-action="Create" class="btn btn-outline-primary">新增公告</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data.FirstOrDefault().CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td class="col-6">
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SN" class="btn btn-primary">編輯</a> |
                    <a asp-action="Details" asp-route-id="@item.SN" class="btn btn-primary">檢視</a> |
                    <form asp-action="Delete">
                        <input type="hidden" value="@item.SN" name="id" />
                        <input type="submit" value="刪除" class="btn btn-danger" onclick="return confirm('確定刪除公告？')" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <!--分頁選擇-->
            @if (Model.PageCount > 1 && Model.TotalDataCount > (int)Model.PageSize)
            {
                <td class="text-center">
                    <nav aria-label="...">
                        <ul class="pagination">
                            <!--上一頁-->
                            <li class="page-item" @(Model.CurrentPage == 1 ? "disabled" : "")>
                                <a class="page-link" href="#" aria-label="Previous" tabindex="-1">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @{
                                for (int a = 1; a <= Model.PageCount; a++)
                                {
                                    <li class="page-item @(Model.CurrentPage == a ? "active" : "")" @(Model.CurrentPage == a ? "aria-current=\"page\"" : "")>
                                        <a class="page-link" href="#">@a</a>
                                    </li>
                                }
                            }

                            <!--下一頁-->
                            <li class="page-item" @(Model.CurrentPage == Model.PageCount ? "disabled" : "")>
                                <a class="page-link" href="#" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </td>
            }
        </tr>
    </tfoot>
</table>
