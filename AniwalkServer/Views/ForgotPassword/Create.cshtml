@using AniwalkServer.DTOs;
@model ForgotPasswordDTO

@{
    ViewData["Title"] = "忘記密碼";
}

<h4>@ViewData["Title"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @if (Model == null || (Model != null && Model.Phase == ForgotPasswordDTOPhase.Email))//Email輸入階段
        {
            <form asp-action="Create" id="EmailForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h3>請輸入在Aniwalk註冊時填入的Email</h3>
                <div class="form-group">
                    @*<label asp-for="VerifyCodeExpiryDate" class="control-label"></label>*@
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <p class="alert-danger">@ViewData["ErrorMessage"]</p>
                <div class="form-group">
                    <input type="submit" value="送出" class="btn btn-primary" />
                </div>
            </form>
        }
        @if (Model != null && Model.Phase == ForgotPasswordDTOPhase.VerifyCode)//驗證碼輸入階段
        {
            <form asp-action="Create" id="VerifyCodeForm">
                <input type="hidden" asp-for="Phase" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h3>請輸入發送至信箱的驗證碼</h3>
                <div class="form-group">
                    <!--為了記住使用者輸入的Email所以需保留此欄位-->
                    <input asp-for="Email" class="form-control" hidden />
                    @*<span asp-validation-for="Email" class="text-danger"></span>*@
                </div>
                <div class="form-group">
                    @*<label asp-for="VerifyCodeExpiryDate" class="control-label"></label>*@
                    <input asp-for="VerifyCode" class="form-control" />
                    <span asp-validation-for="VerifyCode" class="text-danger"></span>
                </div>
                <p class="alert-danger">@ViewData["ErrorMessage"]</p>
                <div class="form-group">
                    <input type="submit" value="送出" class="btn btn-primary" />
                </div>
            </form>
        }
        @if (Model != null && Model.Phase == ForgotPasswordDTOPhase.ChangePassword)//修改密碼階段
        {
            <form asp-action="Create">
                <input type="hidden" asp-for="Phase" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h3>輸入新密碼</h3>
                <div class="form-group">
                    <!--為了記住使用者輸入的Email所以需保留此欄位-->
                    <input asp-for="Email" class="form-control" hidden />
                    @*<span asp-validation-for="Email" class="text-danger"></span>*@
                </div>
                <div class="form-group">
                    <label class="control-label">密碼</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">再輸入一次密碼</label>
                    <input asp-for="NewPasswordConfirm" class="form-control" />
                    <span asp-validation-for="NewPasswordConfirm" class="text-danger"></span>
                </div>
                <p class="alert-danger">@ViewData["ErrorMessage"]</p>
                <div class="form-group">
                    <input type="submit" value="送出" class="btn btn-primary" />
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
