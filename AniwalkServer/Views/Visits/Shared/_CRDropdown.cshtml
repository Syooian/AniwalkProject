@{
    var ID = Guid.NewGuid().ToString();
}

@if (User.IsInRole(Shared.Role_Member))
{
    <div class="dropdown text-end">
        <button type="button" class="rounded-circle border-0 box-shadow" id="@ID" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="~/lib/bootstrap/Icon/three-dots-vertical.svg" />
        </button>
        <ul class="dropdown-menu" aria-labelledby="@ID">
            <li>
                <button class="dropdown-item"><img src="~/lib/bootstrap/Icon/flag.svg" /> 檢舉</button>
            </li>
            @if (Model.PostMemberID == Model.MemberID)//自己的回覆或留言才可刪除
            {
                <li>
                    <button class="dropdown-item" onclick="DeleteContent('@Model.Controller', '@Model.ID')"><img src="~/lib/bootstrap/Icon/x-octagon.svg" /> 刪除</button>
                </li>
            }
        </ul>
    </div>
}