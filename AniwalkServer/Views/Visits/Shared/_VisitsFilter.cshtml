@using AniwalkServer.Data;

@*
移動此檔案位置時，需修改下列檔案的呼叫路徑
@await Html.PartialAsync("~/Views/Visits/Shared/_VisitsFilter.cshtml")

ShowVisitsOnList.cshtml
ShowVisitsOnMap.cshtml
 *@

<div class="accordion" id="accordionExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                搜尋篩選條件
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="accordion-body row">
                <div>
                    到訪國家：<select id="Ipt_CountryName" placeholder="請輸入國家名稱" class="js-example-basic-single">
                        @foreach (var Item in ViewBag.CountryCode)
                        {
                            <option value="@Item.Value">@Item.Text</option>
                        }
                    </select>
                    動畫：<select id="Ipt_AnimeTitle" placeholder="請輸入動畫標題" class="js-example-basic-single">
                        @foreach (var Item in ViewBag.AnimeID)
                        {
                            <option value="@Item.Value">@Item.Text</option>
                        }
                    </select>
                    發表會員：<input id="Ipt_MemberName" placeholder="請輸入會員名字" />
                </div>
                <div>
                    到訪日期：從<input id="Ipt_VisitedDate_From" type="date" />至<input id="Ipt_VisitedDate_To" type="date" />
                </div>
                <div>
                    <button type="button" class="btn btn-primary" onclick="VisitsFiltedSearch()">搜尋</button>
                    <button type="button" class="btn btn-outline-primary" onclick="ResetFilter()">清空</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_Select2");
}

<script>
    const Ipt_CountryName = document.getElementById("Ipt_CountryName");
    const Ipt_AnimeTitle = document.getElementById("Ipt_AnimeTitle");
    const Ipt_MemberName = document.getElementById("Ipt_MemberName");
    const Ipt_VisitedDate_From = document.getElementById("Ipt_VisitedDate_From");
    const Ipt_VisitedDate_To = document.getElementById("Ipt_VisitedDate_To");

    //清空篩選條件
    function ResetFilter(){
        Ipt_CountryName.value="";
        Ipt_AnimeTitle.value="";
        Ipt_MemberName.value="";
        Ipt_VisitedDate_From.value="";
        Ipt_VisitedDate_To.value="";

        VisitsFiltedSearch();
    }

    function VisitsFiltedSearch(){
        let Filters={
            CountryName: Ipt_CountryName.value.trim(),//trim()：去除前後空白
            AnimeTitle: Ipt_AnimeTitle.value.trim(),
            MemberName: Ipt_MemberName.value.trim(),
            VisitedDate_From: Ipt_VisitedDate_From.value,
            VisitedDate_To: Ipt_VisitedDate_To.value
        };

        //console.log(`Filting CountryName : ${Filters.CountryName}, AnimeTitle : ${Filters.AnimeTitle}, MemberName : ${Filters.MemberName}, VisitedDate : ${Filters.VisitedDate}`);

        //用 URLSearchParams 轉換 (不然直接Filters.toString()會印出[object Object]而不是CountryName=xxx&AnimeTitle=yyy&MemberName=zzz&VisitedDate=2025-08-11)
        Filters=new URLSearchParams(Filters);

        console.log(`/Visits/@ViewData["AJAXAction"]?${Filters}`);
        fetch(`/Visits/@ViewData["AJAXAction"]?${Filters}`, {
            method: 'get',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(Response=>Response.text())
        .then(Html=>{
            console.log("Html");
            console.log(Html);

            //給ShowVisitsOnList
            try{
                document.getElementById("VisitsListContainer").innerHTML = Html;
            }
            catch(Error){
                console.error("VisitsFilter Error 1 : "+Error);
            }

            //給ShowVisitsOnMap
            try{
                //將Html Json文字轉成物件
                let FiltedVisits=JSON.parse(Html);
                //console.log("FiltedVisits : "+FiltedVisits);

                SetMarkers(FiltedVisits);
            }
            catch(Error){
                console.error("VisitsFilter Error 2 : "+Error);
            }
        });
    }
</script>
