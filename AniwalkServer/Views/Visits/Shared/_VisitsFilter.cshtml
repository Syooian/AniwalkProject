@model IEnumerable<AniwalkServer.Models.Visits>

@*
移動此檔案位置時，需修改下列檔案的呼叫路徑
@await Html.PartialAsync("~/Views/Visits/Shared/_VisitsFilter.cshtml")

ShowVisitsOnList.cshtml
ShowVisitsOnMap.cshtml
 *@

<div class="accordion" id="accordionExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                搜尋篩選條件
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="accordion-body">
                到訪國家：<input id="Ipt_CountryName" />
                動畫：<input id="Ipt_AnimeTitle" />
                發表會員：<input id="Ipt_MemberName" />
                到訪日期：<input id="Ipt_VisitedDate" />
                <button type="button" class="btn btn-primary" onclick="VisitsFiltedSearch()">搜尋</button>
            </div>
        </div>
    </div>
</div>

@{
    var FilteredVisits = Model;


}

<script>
    const Ipt_CountryName = document.getElementById("Ipt_CountryName");
    const Ipt_AnimeTitle = document.getElementById("Ipt_AnimeTitle");
    const Ipt_MemberName = document.getElementById("Ipt_MemberName");
    const Ipt_VisitedDate = document.getElementById("Ipt_VisitedDate");

    function VisitsFiltedSearch(){
        let Filters={
            CountryName=Ipt_CountryName.value.trim(),//trim()：去除前後空白
            AnimeTitle=Ipt_AnimeTitle.value.trim(),
            MemberName=Ipt_MemberName.value.trim(),
            VisitedDate=Ipt_VisitedDate.value.trim()
        }

        //console.log(`Filting Country : ${Country}, AnimeTitle : ${AnimeTitle}, MemberName : ${MemberName}, VisitedDate : ${VisitedDate}`);
        console.log("Filting : "+Filters);
    }
</script>
