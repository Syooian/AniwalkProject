@model IEnumerable<AniwalkServer.Models.Visits>

<div class="accordion" id="accordionExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                搜尋篩選條件
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
            <div class="accordion-body">
                到訪國家：<input id="Ipt_Country" />
                動畫：<input id="Ipt_Anime" />
                發表會員：<input id="Ipt_Member" />
                到訪日期：<input id="Ipt_VisitedDate" />
                <button type="button" class="btn btn-primary" onclick="VisitsSearch()">搜尋</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Ipt_Country = document.getElementById("Ipt_Country");
    const Ipt_Anime = document.getElementById("Ipt_Anime");
    const Ipt_Member = document.getElementById("Ipt_Member");
    const Ipt_VisitedDate = document.getElementById("Ipt_VisitedDate");

    function VisitsSearch(){
        let Filters={
            Country=Ipt_Country.value,
            Anime=Ipt_Anime.value,
            Member=Ipt_Member.value,
            VisitedDate=Ipt_VisitedDate.value
        }
    }
</script>
