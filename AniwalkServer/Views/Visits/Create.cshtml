@model AniwalkServer.Models.Visits

<h4>新增到訪紀錄</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MainText" class="control-label"></label>
                <textarea asp-for="MainText" class="form-control"></textarea>
                <span asp-validation-for="MainText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <input asp-for="Latitude" class="form-control" readonly/>
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <input asp-for="Longitude" class="form-control" readonly />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedDate" class="control-label"></label>
                <input asp-for="CreatedDate" class="form-control" />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemberID" class="control-label"></label>
                <select asp-for="MemberID" class="form-control" asp-items="ViewBag.MemberID"></select>
            </div>
            <div class="form-group">
                <label asp-for="CountryCode" class="control-label"></label>
                <select asp-for="CountryCode" class="form-control" asp-items="ViewBag.CountryCode"></select>
            </div>
            <div class="form-group">
                <label asp-for="AnimeID" class="control-label"></label>
                <select asp-for="AnimeID" class="form-control" asp-items="ViewBag.AnimeID"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div id="Gmap"
         style="width:500px; height:500px"></div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=InitMap&libraries=marker&v=weekly" defer></script>
<script>
    var Marker;

    function InitMap(){
        console.log("Initing GoogleMap");

        // 設定地圖中心點
        const center = { lat: 22.593469753520136, lng: 120.3088710110155 };

         // 建立地圖
        const map = new google.maps.Map(document.getElementById("Gmap"), {
            center: center,
            zoom: 10,
            mapId: "DEMO_MAP_ID"
        });

        // 監聽地圖的點擊事件
        map.addListener("click", (Event) => {
            const Lat = Event.latLng.lat();
            const Lng = Event.latLng.lng();

            // 將座標填入表單欄位
            document.querySelector("input[name='Latitude']").value = Lat;
            document.querySelector("input[name='Longitude']").value = Lng;

            //移除地圖上舊有Marker
            if (Marker) {
                Marker.setMap(null);
            }

            //在地圖上建立新Marker
            Marker = new google.maps.marker.AdvancedMarkerElement({
                position: { lat: Lat, lng: Lng },
                map: map,
                title: "新增到訪紀錄"
            });
        });
    }

    window.InitMap = InitMap; // 將 InitMap 函數暴露給全域作用域，以便 Google Maps API 可以調用它
</script>

<div>
    <a asp-action="ShowVisitsOnList">返回清單</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
