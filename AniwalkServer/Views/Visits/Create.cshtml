@model AniwalkServer.Models.Visits

<h4>新增到訪紀錄</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MainText" class="control-label"></label>
                <textarea asp-for="MainText" class="form-control"></textarea>
                <span asp-validation-for="MainText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <input asp-for="Latitude" class="form-control" readonly />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <input asp-for="Longitude" class="form-control" readonly />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                @*<label asp-for="MemberID" class="control-label"></label>*@
                <select asp-for="MemberID" class="form-control" asp-items="ViewBag.MemberID" hidden></select>
            </div>
            <div class="form-group">
                <label asp-for="CountryCode" class="control-label"></label>
                <select asp-for="CountryCode" class="form-control" asp-items="ViewBag.CountryCode"></select>
            </div>
            <div class="form-group">
                <label asp-for="AnimeID" class="control-label"></label>
                <select asp-for="AnimeID" class="form-control" asp-items="ViewBag.AnimeID"></select>
            </div>
            <div class="form-group">
                <label asp-for="VisitedDate" class="control-label"></label>
                <input asp-for="VisitedDate" class="form-control" />
                <span asp-validation-for="VisitedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
            </div>
        </form>
    </div>
    @await Html.PartialAsync("_SharedMap", new { EnableClick = true })
</div>

<div>
    <a asp-action="ShowVisitsOnList" class="btn btn-outline-primary">返回列表</a>
</div>

<hr />

@*照片*@
<!-- 隱藏的文件選擇器 -->
<input type="file" id="PhotoSelecter" accept="image/*" multiple style="display: none;" onchange="OnPhotoChange(event)" />
<!-- 新增照片按鈕 -->
<button type="button" class="btn btn-primary" onclick="OpenPhotoPicker()">
    新增照片
</button>

@if (Model?.VisitsPhotos.Count > 0)
{
    <hr />
    <div class="row justify-content-center" id="PhotoContainer">
        @foreach (var Photo in Model.VisitsPhotos)
        {
            <div class="card mt-1 mb-1 ms-1 me-1" style="max-width: 18rem;">
                <button type="button" class="btn btn-outline-primary">刪除</button>
                <img class="card-img-top" src="@($"/{Shared.VisitsPhotosRootPath}/{Model.MemberID}/{Photo.PhotoID}.jpg")" alt="Card image cap">
                <div class="card-body">
                    <!--h5 class="card-title">Card title</h5>-->
                    <textarea asp-for="MainText" class="form-control" rows="10"></textarea>
                </div>
            </div>
        }
    </div>
}
@*照片*@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        //開啟圖片多選
        function OpenPhotoPicker(){
            document.getElementById("PhotoSelecter").click();
        }

        //處理圖片選擇
        function OnPhotoChange(event){
            console.log("選取了 "+event.target.files.length+" 張照片");
        }
    </script>
}
