@model VM_Visits

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Countries.FirstOrDefault().CountryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Animes.FirstOrDefault().Title)
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.Visits.FirstOrDefault().MainText)*@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Members.FirstOrDefault().Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Visits.FirstOrDefault().CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Visits)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Country.CountryName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Anime.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MainText)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Member.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AnimeID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.AnimeID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.AnimeID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
