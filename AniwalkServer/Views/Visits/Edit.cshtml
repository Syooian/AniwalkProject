@using AniwalkServer.Data
@model AniwalkServer.Models.Visits

@{
    ViewData["FormAction"] = "Edit";

    string MapData = Shared.GetMapDataJsonEscapeDataString(ViewData);
}

<h4>編輯到訪紀錄</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" id="DataForm" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SN" />
            <div class="form-group">
                <label asp-for="MainText" class="control-label"></label>
                <textarea asp-for="MainText" class="form-control" rows="10"></textarea>
                <span asp-validation-for="MainText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <input asp-for="Latitude" class="form-control" readonly />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <input asp-for="Longitude" class="form-control" readonly />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="CreatedDate" class="form-control" hidden />
            </div>
            <div class="form-group">
                @*<label asp-for="MemberID" class="control-label"></label>*@
                <input asp-for="MemberID" class="form-control" value="@ViewBag.MemberID" hidden />
                <span asp-validation-for="MemberID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CountryCode" class="control-label"></label>
                <select asp-for="CountryCode" class="form-control js-example-basic-single">
                    @*@foreach (var Item in (ViewBag.CountryCode ?? new List<SelectListItem>()))*@@*遇到null時的處理*@
                    @foreach (var Item in ViewBag.CountryCode)
                    {
                        <option value="@Item.Value">@Item.Text</option>
                    }
                </select>
                <span asp-validation-for="CountryCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnimeID" class="control-label"></label>
                <select asp-for="AnimeID" class="form-control js-example-basic-single">
                    @*@foreach (var Item in (ViewBag.AnimeID ?? new List<SelectListItem>()))*@@*遇到null時的處理*@
                    @foreach (var Item in ViewBag.AnimeID)
                    {
                        <option value="@Item.Value">@Item.Text</option>
                    }
                </select>
                <span asp-validation-for="AnimeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VisitedDate" class="control-label"></label>
                <input asp-for="VisitedDate" class="form-control" type="date"/>
                <span asp-validation-for="VisitedDate" class="text-danger"></span>
            </div>
            @*<div class="form-group">
                <input type="file" name="PhotoUpload" class="form-control" accept=".jpg,.jpeg,.png,.jfif,.bmp,.gif" multiple id="PhotoSelecter" hidden onchange="OnPhotoChange(this)" /><!--所有圖片類型：image/*-->
                <span class="text-danger">@ViewData["PhotoError"]</span>
            </div>*@
            <div class="form-group" id="PhotoForm">
                @* @for (int a = 0; a < Model.VisitsPhotos.Count; a++)
                    {
                        <div>
                            @Model.VisitsPhotos[a].PhotoID
                            <input asp-for="@Model.VisitsPhotos[a].MemberID" class="form-control" value="@Model.MemberID" />
                            <input asp-for="@Model.VisitsPhotos[a].PhotoID" class="form-control" />
                            <input asp-for="@Model.VisitsPhotos[a].PhotoType" class="form-control" />
                            <textarea asp-for=@Model.VisitsPhotos[a].Description" class="form-control"></textarea>
                        </div>
                    } *@
            </div>
            <div class="form-group">
                @*<input type="submit" value="修改" class="btn btn-primary" />*@
                <input type="hidden" name="LastPage" value="@ViewData[ViewDataKeys.LastPage]" />
                <input type="hidden" name="LastAction" value="@ViewData[ViewDataKeys.AJAXAction]" />
                <input type="hidden" name="MapDataParam" value="@ViewData[ViewDataKeys.MapData]" />
                <input type="button" value="修改" class="btn btn-primary" onclick="SendForm()" />
                <a asp-action="@ViewData[ViewDataKeys.AJAXAction]" class="btn btn-outline-primary" asp-route-MapDataParam="@MapData" asp-route-Page="@ViewData[ViewDataKeys.LastPage]">返回列表</a>
            </div>
        </form>
    </div>
    @await Html.PartialAsync("_SharedMap", new { Latitude = Model.Latitude, Longitude = Model.Longitude, EnableClick = true })
</div>

<hr />

@*照片*@
@await Html.PartialAsync("_PhotoContainer")
@*照片*@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @await Html.PartialAsync("_Select2");
}