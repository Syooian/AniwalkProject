@model PageDTO<VisitsDTO>
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using System.Security.Claims
@using AniwalkServer.DTOs
@inject IModelMetadataProvider MetadataProvider
@{
    var MemberID = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var CountryDisplayName = MetadataProvider.GetMetadataForType(typeof(Visits))
        .Properties.FirstOrDefault(p => p.Name == nameof(Visits.CountryCode)).DisplayName;
    var AnimeTitle = MetadataProvider.GetMetadataForType(typeof(Animes))
        .Properties.FirstOrDefault(P => P.Name == nameof(Animes.Title)).DisplayName;
    var MemberName = MetadataProvider.GetMetadataForType(typeof(Members))
        .Properties.FirstOrDefault(P => P.Name == nameof(Members.Name)).DisplayName;
}

@if (Model.Data.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @*@Html.DisplayNameFor(model => model.Data.FirstOrDefault().CountryCode)*@
                    @CountryDisplayName
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.Data.FirstOrDefault().Anime.Title)*@
                    @AnimeTitle
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.Longitude)*@
                </th>
                <th>
                    @*@Html.DisplayNameFor(model => model.Data.FirstOrDefault().Member.Name)*@
                    @MemberName
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Data.FirstOrDefault().VisitedDate)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CountryName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MainText)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.VisitedDate)
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-VisitSN="@item.SN" class="btn btn-info btn-sm">詳細檢視</a>
                        @if (MemberID == item.MemberID)
                        {
                            <a>|</a>
                            <a asp-action="Edit" asp-route-VisitSN="@item.SN" class="btn btn-primary btn-sm">編輯</a>
                            <a>|</a>
                            <form asp-action="Delete">
                                <input type="hidden" value="@item.SN" name="VisitSN" />
                                <input type="submit" value="刪除" class="btn btn-danger btn-sm" onclick="return confirm('您確定要刪除此筆資料嗎?')" />
                            </form>
                        }
                        else if (User.IsInRole(RoleEnum.Admin.ToString()))
                        {
                            <a>|</a>
                            <form asp-action="Delete">
                                <input type="hidden" value="@item.SN" name="VisitSN" />
                                <input type="submit" value="刪除" class="btn btn-danger btn-sm" onclick="return confirm('您確定要刪除此筆資料嗎?')" />
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <!--分頁選擇-->
                @if (Shared.CheckShowPage(Model.PageCount, Model.TotalDataCount, Model.PageSize))
                {

                }
            </tr>
        </tfoot>
    </table>
}
else
{
    <h3 class="text-center">無任何到訪記錄，等你來分享!!!</h3>
}