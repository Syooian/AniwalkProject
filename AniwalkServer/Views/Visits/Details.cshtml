    @await Component.InvokeAsync("VC_Comment", new { VisitSN = Model.SN, IsChange = false })
</div> *@

<script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=InitMap&libraries=marker&v=weekly" defer></script>
<script>
    var Marker;

    function InitMap(){
        console.log("Initing GoogleMap");

        // 設定地圖中心點
        const center = { lat: @Model.Latitude, lng: @Model.Longitude };

         // 建立地圖
        const map = new google.maps.Map(document.getElementById("Gmap"), {
            center: center,
            zoom: 10,
            mapId: "DEMO_MAP_ID"
        });

        Marker = new google.maps.marker.AdvancedMarkerElement({
            position: center,
            map: map,
            title: "新增到訪紀錄"
        });
    }

    window.InitMap = InitMap; // 將 InitMap 函數暴露給全域作用域，以便 Google Maps API 可以調用它
</script>

<!--===================================檢視大圖===================================-->
<div class="modal fade" id="LargePhotoModal" tabindex="-1" aria-labelledby="LargePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!--Carousel-->
                <div id="PhotosCarousel" class="carousel slide" data-bs-interval="false">
                    <div class="carousel-inner" style="height:500px">
                        @for (int a = 0; a < Model.VisitsPhotos.Count; a++)
                        {
                            <div class="carousel-item @(a == 0 ? "active" : "")">
                                <img class="d-block w-100 h-100" style="object-fit: contain" src="@($"/{Shared.VisitsPhotosRootPath}/{Model.MemberID}/{Model.VisitsPhotos[a].PhotoID}{Model.VisitsPhotos[a].PhotoType}")" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#PhotosCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#PhotosCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--===================================檢視大圖===================================-->