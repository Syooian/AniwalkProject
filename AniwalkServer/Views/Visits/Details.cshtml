@model AniwalkServer.Models.Visits

<div>
    <h4>Visits</h4>
    <hr />
    <div class="d-flex justify-content-between align-items-start">
        <dl class="row col-5">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.MainText)
            </dt>
            <dd class="col-sm-9">
                @Html.Raw(Model.MainText.Replace("\r\n", "<br>"))
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Latitude)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Latitude)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Longitude)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Longitude)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.VisitedDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.VisitedDate)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Member)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Member.Name)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Country)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Country.CountryName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Anime)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Anime.Title)
            </dd>
        </dl>
        @*   @{
            await Component.InvokeAsync("VC_Map");
        } *@
        <div id="Gmap"
             style="width:500px; height:500px"></div>
    </div>
</div>
<div>
    <!--彈出回覆留言框的按鈕 -->
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#CommentModal">
        留言
    </button> |
    <a asp-action="Edit" asp-route-VisitSN="@Model?.SN">Edit</a> |
    <a asp-action="ShowVisitsOnList">Back to List</a>
</div>

<!--留言框Modal-->
<div class="modal fade" id="CommentModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">我要留言</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* //嵌入回覆留言表單 *@
                <div id="CommentForm" class="bg-light p-2 rounded">
                </div>
            </div>
        </div>
    </div>
</div>
<!--留言框Modal-->
<!--留言框Script-->
@section Scripts {
    @*前端驗證套件*@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function LoadCommentForm(){
            console.log("LoadCommentForm");

            //使用Callback function重新綁定 unobtrusive validation
            $('#CommentForm').load('/Comments/Create?VisitSN=@Model.SN',function(){
                //Load結束之後才會呼叫此function
                //unobtrusive：<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js">其中的==>unobtrusive<==
                    $.validator.unobtrusive.parse($('#CommentForm'));
            });
        }

        LoadCommentForm();

        //抓彈出框
        const Modal=new bootstrap.Modal(document.getElementById('CommentModal'));

        //使用Ajax達成新增回覆留言
        function AddComment(){
            //2.5.17判斷表單是否驗證通過
                if(!$('#CommentForm form').valid()){
                //驗證失敗，不送出表單
                return;
            }

            $.ajax({
                type:"POST",
                url:"/Comment/Create",//Controller/Action
                    data:$('#CommentForm form').serialize(),
                success:function(){
                    //更新底下回覆留言區
                    $('#CommentsList').load('/Comments/GetCommentsByViewComponent?VisitSN=@(Model.SN)');

                    //將表單重新載入（也可在送出表單後重新產生GUID）
                    // $('#CommentForm').load('/ReBooks/Create?ID=@(Model.SN)',function(){
                    //     $.validator.unobtrusive.parse($('#CommentForm'));
                    // });
                    LoadCommentForm();

                    //關閉彈出框
                    Modal.hide();
                },
                error:function(){
                    console.log("新增回覆留言錯誤");
                }
            });
        }
    </script>
}
<!--留言框Script-->
<hr />

<!--所有回覆留言-->
<div id="CommentsList">
    @await Component.InvokeAsync("VC_Comment", new { VisitSN = Model.SN, IsChange = false })
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=InitMap&libraries=marker&v=weekly" defer></script>
<script>
    var Marker;

    function InitMap(){
        console.log("Initing GoogleMap");

        // 設定地圖中心點
        const center = { lat: @Model.Latitude, lng: @Model.Longitude };

         // 建立地圖
        const map = new google.maps.Map(document.getElementById("Gmap"), {
            center: center,
            zoom: 10,
            mapId: "DEMO_MAP_ID"
        });

        Marker = new google.maps.marker.AdvancedMarkerElement({
            position: center,
            map: map,
            title: "新增到訪紀錄"
        });
    }

    window.InitMap = InitMap; // 將 InitMap 函數暴露給全域作用域，以便 Google Maps API 可以調用它
</script>
