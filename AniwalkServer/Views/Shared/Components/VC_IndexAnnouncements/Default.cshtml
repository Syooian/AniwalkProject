@model AniwalkServer.DTOs.PageDTO<Announcements>

<div class="text-center" id="IndexAnnouncements">
    @if (Model.Data.Any())
    {
        <h3>公告</h3>
        <hr />
        <div class="mx-auto rounded-1 border border-info p-3 bg-light" style="max-width:800px">
            @foreach (var Item in Model.Data)
            {
                var ID = $"AC{Item.SN}";

                <div>
                    <div class="btn btn-outline-primary w-100 text-start" data-bs-toggle="collapse" href="#@ID" role="button" aria-expanded="false" aria-controls="#@ID">
                        <div class="d-flex justify-content-between">
                            <span class="text-end">@Item.CreatedDate：@Item.Title</span>
                        </div>
                    </div>
                    <div class="collapse  w-100 text-start" id="@ID">
                        <div class="card card-body">
                            @Html.Raw(Shared.ConvertNewLineToBr(Item.Content))
                        </div>
                    </div>
                </div>

                <hr />
            }
            <!--分頁選擇-->
            @if (Shared.CheckShowPage(Model.PageCount, Model.TotalDataCount, Model.PageSize))
            {
                <nav aria-label="...">
                    <ul class="pagination">
                        <!--上一頁-->
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="Reload(@Model.CurrentPage - 1)" aria-label="Previous" tabindex="-1">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        @{
                            for (int a = 1; a <= Model.PageCount; a++)
                            {
                                <li class="page-item @(Model.CurrentPage == a ? "active" : "")" @(Model.CurrentPage == a ? "aria-current=\"page\"" : "")>
                                    <a class="page-link" href="javascript:void(0)" onclick="Reload(@a)">@a</a>
                                </li>
                            }
                        }

                        <!--下一頁-->
                        <li class="page-item @(Model.CurrentPage == Model.PageCount ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="Reload(@Model.CurrentPage+1)" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <h3>目前沒有公告。</h3>
    }
</div>

<script>
    function Reload(Page){
        var URL=`/Announcements/IndexAnnouncementsPartial?NewPage=${Page}`;
        //console.log(URL);
         $("#IndexAnnouncements").load(URL);
    }
</script>