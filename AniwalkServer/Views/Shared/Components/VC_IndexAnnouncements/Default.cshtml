@model AniwalkServer.DTOs.PageDTO<Announcements>

<div class="text-center">
    @if (Model.Data.Any())
    {
        <h3>公告</h3>
        <hr />
        <div class="mx-auto rounded-1 border border-info p-3 bg-light" style="max-width:800px">
            @foreach (var Item in Model.Data)
            {
                var ID = $"AC{Item.SN}";

                <div>
                    <div class="btn btn-outline-primary w-100 text-start" data-bs-toggle="collapse" href="#@ID" role="button" aria-expanded="false" aria-controls="#@ID">
                        <div class="d-flex justify-content-between">
                            <span class="text-end">@Item.CreatedDate：@Item.Title</span>
                        </div>
                    </div>
                    <div class="collapse  w-100 text-start" id="@ID">
                        <div class="card card-body">
                            @Html.Raw(Item.Content.Replace("\r\n", "<br>"))
                        </div>
                    </div>
                </div>

                <hr />
            }
            <!--分頁選擇-->
            @if (Model.PageCount > 1 && Model.TotalDataCount > (int)Model.PageSize)
            {
                <nav aria-label="...">
                    <ul class="pagination">
                        <!--上一頁-->
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage - 1)" aria-label="Previous" tabindex="-1">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        @{
                            for (int a = 1; a <= Model.PageCount; a++)
                            {
                                <li class="page-item @(Model.CurrentPage == a ? "active" : "")" @(Model.CurrentPage == a ? "aria-current=\"page\"" : "")>
                                    <a class="page-link" asp-action="Index" asp-route-Page="@a">@a</a>
                                </li>
                            }
                        }

                        <!--下一頁-->
                        <li class="page-item @(Model.CurrentPage == Model.PageCount ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage + 1)" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <h3>目前沒有公告。</h3>
    }
</div>