@model IEnumerable<Announcements>

<div class="text-center">
    @if (Model.Any())
    {
        <h3>公告</h3>
        <hr />
        <div class="mx-auto rounded-1 border border-info p-3 bg-light" style="max-width:800px">
            @foreach (var Item in Model)
            {
                var ID = $"AC{Item.SN}";

                <div>
                    <div class="btn btn-outline-primary w-100 text-start" data-bs-toggle="collapse" href="#@ID" role="button" aria-expanded="false" aria-controls="#@ID">
                        <div class="d-flex justify-content-between">
                            <span class="text-end">@Item.CreatedDate：@Item.Title</span>
                        </div>
                    </div>
                    <div class="collapse  w-100 text-start" id="@ID">
                        <div class="card card-body">
                            @Html.Raw(Item.Content.Replace("\r\n", "<br>"))
                        </div>
                    </div>
                </div>

                <hr />
            }
        </div>
    }
    else
    {
        <h3>目前沒有公告。</h3>
    }
</div>