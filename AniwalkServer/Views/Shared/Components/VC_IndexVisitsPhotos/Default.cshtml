@model List<AniwalkServer.Models.VisitsPhotos>
@{
    Layout = null;
    bool IsFirst = true;
}

<div id="VisitsPhotosCarousel" class="carousel slide" data-bs-ride="carousel" style="height: 500px">
    <div class="carousel-inner h-100">
        @foreach (var Photo in Model)
        {
            <div class="carousel-item @(IsFirst ? "active" : "")">
                <img src=@($"/{Shared.GetVisitsPhotoPath(Photo.MemberID, Photo.PhotoID, Photo.PhotoType)}") class="d-block w-75 mx-auto h-100" style="object-fit: contain; max-height: 100%;">
            </div>

            IsFirst = false;
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#VisitsPhotosCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#VisitsPhotosCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>