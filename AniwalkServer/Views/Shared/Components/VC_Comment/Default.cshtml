@model IEnumerable<Comments>
@{
    Layout = null;
}

@{
    Console.WriteLine($"Rendering Comments View Component {Model.Count()}");
}

@if (Model.Count() > 0)
{
    <div class="border border-1 rounded p-3 bg-light">
        @foreach (var Item in Model)
        {
            <p>@Html.DisplayFor(ModelItem => Item.CommentText)</p>
            <p class="text-end">
                @Html.DisplayFor(ModelItem => Item.MemberID)：@Html.DisplayFor(ModelItem => Item.CommentDate)
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#CommentModal">
                    回覆
                </button>
            </p>
            
            <hr />
        }
    </div>
}