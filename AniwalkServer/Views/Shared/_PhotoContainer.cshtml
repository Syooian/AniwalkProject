@model AniwalkServer.Models.Visits

<!-- 隱藏的文件選擇器 -->
@*<input type="file" id="PhotoSelecter" accept="image/*" multiple style="display: none;" onchange="OnPhotoChange(this)" />*@<!--如果 event 被標示為已淘汰，建議在函式中明確地傳遞事件物件，並避免依賴全域的 event 物件 (更安全且現代的做法)-->
<!-- 新增照片按鈕 -->
<button type="button" class="btn btn-primary" onclick="OpenPhotoPicker()">
    新增照片
</button>

@{
    //將後端傳來的圖片資料經由Json傳給前端
    var PhotoListJson = "[]";
    /*
     * var PhotoListJson= "";
     * 這樣輸出的是「物件」而不是「字串」，所以 PhotoListJson 必須是合法的 JSON，不能是空字串，否則會造成 JS 錯誤。
     */
    @if (Model != null && Model.VisitsPhotos != null)
    {
        PhotoListJson = System.Text.Json.JsonSerializer.Serialize(
            Model.VisitsPhotos.Select(PhotoListJson => new
            {
                PhotoID = PhotoListJson.PhotoID,
                PhotoType = PhotoListJson.PhotoType,
                PhotoSrc = $"/{Shared.VisitsPhotosRootPath}/{Model.MemberID}/{PhotoListJson.PhotoID}.jpg",
                Description = PhotoListJson.Description
            })
        );
    }
}

@*顯示所有圖片Card的容器*@
<div class="row justify-content-center" id="PhotoContainer">
</div>

<script>
    //下方顯示所有圖片Card的容器
    const PhotoContainer = document.getElementById("PhotoContainer");
    //表單內容納所有圖片說明和資訊的容器
    const PhotoForm=document.getElementById("PhotoForm");
    //隱藏的圖片選擇器
    const PhotoSelecter=document.getElementById("PhotoSelecter");

    //初始化圖片顯示和既有圖片資料插入表單
    function InitPhotoContainer(){
        //從後端傳遞的圖片資料
        const Json=@Html.Raw(PhotoListJson);

        if(Json!=null)
        {
            console.log(Json);

            for(let a=0;a<Json.length;a++)
            {
                SetPhotoCard(a,Json[a].PhotoSrc, Json[a].Description);

                SetPhotoFormData(a, Json[a].PhotoID, Json[a].PhotoType,Json[a].Description);
            }
        }
        else
        {
            console.log("沒有圖片資料");
        }
    }
    InitPhotoContainer();


    //開啟圖片多選
    function OpenPhotoPicker(){
        PhotoSelecter.click();
    }

    //獲取檔案副檔名
    function GetFileExtension(FileName) {
        const Extension=FileName.split('.');
        return "."+Extension[Extension.length-1].toLowerCase();
    }

    // 獲取圖片表單資料的 ID
    function GetPhotoFormDataID(ID){
        return `PhotoFormData_${ID}`;
    }

    //更新圖片說明
    function UpdateDescription(ID, Value){
        document.getElementById(`${GetPhotoFormDataID(ID)}`).querySelector("textarea").value=Value;
    }

    // 刪除圖片
    function RemovePhoto(ID, ButtonElement) {
        //刪除表單內對應的圖片div
        var PhotoDIV=document.getElementById(`${GetPhotoFormDataID(ID)}`);
        if (PhotoDIV) {
            PhotoDIV.remove();
        }

        //刪除照片選擇的圖片
        /*
        1.	HTML 的 <input type="file"> 元素特性：
            •	一旦檔案被選擇，無法直接從 JavaScript 中刪除特定的檔案，因為 FileList 是唯讀的。
            •	解決方法是清空整個 PhotoSelecter 的值，然後重新管理已選擇的檔案。
        2.	解決方案：
            •	使用一個全域變數（如 selectedFiles）來儲存使用者選擇的檔案。
            •	當使用者刪除某個檔案時，從該變數中移除對應的檔案，並更新顯示。
        */

        const Card = ButtonElement.parentElement;
        Card.remove();
    }

    //處理圖片選擇
    function OnPhotoChange(InputElement){
        const Files=InputElement.files;
        console.log("選取了 "+Files.length+" 張照片");

        for(let a=0;a<Files.length;a++){
            console.log("處理第 "+(a+1)+" 張照片");

            // 使用 FileReader 讀取圖片
            const Reader=new FileReader();
            Reader.onloadend=function(E){
                //let PhotoNum=a;

                SetPhotoCard(a, E.target.result, "");

                try
                {
                    console.log(a);
                    console.log("PhotoName : "+Files[a]);
                }
                catch
                {

                }

                SetPhotoFormData(a, crypto.randomUUID(), GetFileExtension(Files[a].name), "");
            }

            Reader.readAsDataURL(Files[a]); // 讀取圖片為 Data URL
        }

        console.log("圖片處理完成");
    }

    //設置圖片顯示
    function SetPhotoCard(ID, PhotoSrc, Description){
        const Card=document.createElement("div");
        Card.className="card mt-1 mb-1 ms-1 me-1";
        Card.style.maxWidth = "18rem";

        Card.innerHTML=`
            <button type="button" class="btn btn-outline-primary" onclick="RemovePhoto(${ID}, this)">刪除</button>
            <img class="card-img-top" src="${PhotoSrc}" alt="Card image cap">
            <div class="card-body">
                <p class="card-title">照片說明</p>
                <textarea name="VisitsPhotos[${ID}].Description" rows="10" onchange="UpdateDescription(${ID}, this.value)">${Description}</textarea>
            </div>
        `;
        /*
            1.	${this.value} 的問題：
                •	this.value 是 JavaScript 的屬性，但在 HTML 中直接使用 ${} 是模板字串語法，這只在 JavaScript 中有效。
                •	在 HTML 中，${this.value} 不會被解析為 JavaScript 表達式，而是被當作普通字串處理，導致傳遞的值為 undefined。
            2.	作用域問題：
                •	this 在 onchange 中應該指向觸發事件的 <textarea> 元素，但因為模板字串語法錯誤，this 並未正確解析。
        */

        PhotoContainer.appendChild(Card);
    }

    //設置表單內圖片資料
    function SetPhotoFormData(ID, PhotoID, PhotoType, Description){
        const FormData = document.createElement("div");
        FormData.id = GetPhotoFormDataID(ID);
        FormData.innerHTML = `
            <input name="VisitsPhotos[${ID}].MemberID" class="form-control" value="@ViewBag.MemberID" />
            <input name="VisitsPhotos[${ID}].PhotoID" class="form-control" value="${PhotoID}" />
            <input name="VisitsPhotos[${ID}].PhotoType" class="form-control" value="${PhotoType}" />
            <textarea name="VisitsPhotos[${ID}].Description" class="form-control">${Description}</textarea>
        `;

        PhotoForm.appendChild(FormData);
    }
</script>