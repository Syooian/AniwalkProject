@using AniwalkServer.Data
@model AniwalkServer.Models.Visits

<!-- 隱藏的文件選擇器 -->
<!--如果 event 被標示為已淘汰，建議在函式中明確地傳遞事件物件，並避免依賴全域的 event 物件 (更安全且現代的做法)-->
<!--所有圖片類型：image/*-->
<input type="file" class="form-control" accept=".jpg,.jpeg,.png,.jfif,.bmp,.gif" multiple id="PhotoPicker" hidden onchange="OnPhotoChange(this)" />
<!-- 新增照片按鈕 -->
<button type="button" class="btn btn-primary" onclick="OpenPhotoPicker()">
    新增照片
</button>
<span class="text-danger">@ViewData["PhotoError"]</span>

@{
    //將後端傳來的圖片資料經由Json傳給前端
    var PhotoListJson = "[]";
    /*
     * var PhotoListJson= "";
     * 這樣輸出的是「物件」而不是「字串」，所以 PhotoListJson 必須是合法的 JSON，不能是空字串，否則會造成 JS 錯誤。
     */
    @if (Model != null && Model.VisitsPhotos != null)
    {
        PhotoListJson = System.Text.Json.JsonSerializer.Serialize(
            Model.VisitsPhotos.Select(PhotoListJson => new
            {
                PhotoID = PhotoListJson.PhotoID,
                PhotoType = PhotoListJson.PhotoType,
                PhotoSrc = $"/{Shared.VisitsPhotosRootPath}/{Model.MemberID}/{PhotoListJson.PhotoID}{PhotoListJson.PhotoType}",
                Description = PhotoListJson.Description
            })
        );
    }

    string MapData = Shared.GetMapDataJsonEscapeDataString(ViewData);//PartialView不會抓到主頁的變數，所以要再做一次
}

@*顯示所有圖片Card的容器*@
<div class="row justify-content-center" id="PhotoContainer">
</div>

<script>
    //下方顯示所有圖片Card的容器
    const PhotoContainer = document.getElementById("PhotoContainer");
    //表單內容納所有圖片說明和資訊的容器
    const PhotoForm=document.getElementById("PhotoForm");
    //隱藏的圖片選擇器
    const PhotoPicker=document.getElementById("PhotoPicker");

    //儲存所有選取的圖片資料
    let SelectedPhoto=[];

    //初始化圖片顯示和既有圖片資料插入表單
    function InitPhotoContainer(){
        //從後端傳遞的圖片資料
        const Json=@Html.Raw(PhotoListJson);

        if(Json!=null)
        {
            console.log(Json);

            for(let a=0;a<Json.length;a++)
            {
                SetPhotoCard(a, Json[a].PhotoSrc, Json[a].Description);

                SetPhotoFormData(a, Json[a].PhotoID, Json[a].PhotoType, Json[a].Description);

                //如果模型傳來時已有圖片，也將其加入已選取檔案陣列
                SetSelectPhoto(a,  Json[a].PhotoID, Json[a].PhotoType, Json[a].Description, null); //這裡的 null 代表沒有實際的 File 物件，因為這是從後端載入的資料
            }
        }
        else
        {
            console.log("沒有圖片資料");
        }
    }
    InitPhotoContainer();


    //開啟文件選擇器
    function OpenPhotoPicker(){
        PhotoPicker.click();
    }

    //獲取檔案副檔名
    function GetFileExtension(FileName) {
        const Extension=FileName.split('.');
        return "."+Extension[Extension.length-1].toLowerCase();
    }

    // 獲取圖片表單資料的 ID
    function GetPhotoFormDataID(ID){
        return `PhotoFormData_${ID}`;
    }

    // 獲取圖片卡片的 ID
    function GetPhotoCardID(ID){
        return `PhotoCard_${ID}`;
    }

    //更新圖片說明
    function UpdateDescription(ID, Value){
        //document.getElementById(`${GetPhotoFormDataID(ID)}`).querySelector("textarea").value=Value;

        SelectedPhoto[ID].Description=Value;
    }

    // 刪除圖片
    function RemovePhoto(ID, ButtonElement) {
        //console.log("刪除圖片 ID : "+ID);

        //刪除表單內對應的圖片div
        let PhotoForm=document.getElementById(GetPhotoFormDataID(ID));
        if (PhotoForm) {
            PhotoForm.remove();
        }

        //刪除照片選擇的圖片
        /*
        1.	HTML 的 <input type="file"> 元素特性：
            •	一旦檔案被選擇，無法直接從 JavaScript 中刪除特定的檔案，因為 FileList 是唯讀的。
            •	解決方法是清空整個 PhotoSelecter 的值，然後重新管理已選擇的檔案。
        2.	解決方案：
            •	使用一個全域變數（如 selectedFiles）來儲存使用者選擇的檔案。
            •	當使用者刪除某個檔案時，從該變數中移除對應的檔案，並更新顯示。
        */
       /*
        filter：SelectedPhoto = SelectedPhoto.filter(photo => photo.ID !== ID);
            •	會建立一個新的陣列，包含所有符合條件的項目。在這裡，所有 photo.ID 不等於 ID 的項目，達到移除的效果。
        splice：const index = SelectedPhoto.findIndex(photo => photo.ID === ID);
                        if (index !== -1) {
                            SelectedPhoto.splice(index, 1);
                        }
            •	直接修改原陣列，從指定的索引位置移除項目。需要先用 findIndex 找到目標項目的索引。
       */
       let DeleteIndex=SelectedPhoto.findIndex(P=>P.ID===ID);
       if(DeleteIndex!==-1){
           SelectedPhoto.splice(DeleteIndex, 1);//移除從索引 DeleteIndex 開始的 1 個項目。
       }

       //刪除Card
        const Card = ButtonElement.parentElement;
        Card.remove();

        //console.log(`移除已選取的第 ${DeleteIndex+1} 張圖片`);

        //PrintSelectedPhoto();

        //將刪除ID後面的所有ID都往前移
        for(let a=DeleteIndex;a<SelectedPhoto.length;a++){
            //let FormerID=SelectedPhoto[a].ID;//先記下變更前的ID

            //更新表單內對應的圖片資料ID
            //console.log("找 "+GetPhotoFormDataID(SelectedPhoto[a].ID));
            const FormData=document.getElementById(GetPhotoFormDataID(SelectedPhoto[a].ID));
            if(FormData){
                //console.log("找到 "+GetPhotoFormDataID(SelectedPhoto[a].ID));
                FormData.id=GetPhotoFormDataID(a);
                //console.log("更改ID為 "+FormData.id);

                FormData.querySelector(`input[name='VisitsPhotos[${SelectedPhoto[a].ID}].MemberID']`)
                    .setAttribute("name", `VisitsPhotos[${a}].MemberID`);
                FormData.querySelector(`input[name='VisitsPhotos[${SelectedPhoto[a].ID}].PhotoID']`)
                    .setAttribute("name", `VisitsPhotos[${a}].PhotoID`);
                FormData.querySelector(`input[name='VisitsPhotos[${SelectedPhoto[a].ID}].PhotoType']`)
                    .setAttribute("name", `VisitsPhotos[${a}].PhotoType`);
                FormData.querySelector(`textarea[name='VisitsPhotos[${SelectedPhoto[a].ID}].Description']`)
                    .setAttribute("name", `VisitsPhotos[${a}].Description`);
            }

            //更新Card
            //console.log("找 "+GetPhotoCardID(SelectedPhoto[a].ID));
            const Card=document.getElementById(GetPhotoCardID(SelectedPhoto[a].ID));
            if(Card){
                Card.id=GetPhotoCardID(a);

                Card.onclick=function(){RemovePhoto(a,this);}

                const TextArea=Card.querySelector(`textarea[name='VisitsPhotos[${SelectedPhoto[a].ID}].Description']`);
                if(TextArea){
                    TextArea.setAttribute("name", `VisitsPhotos[${a}].Description`);
                    TextArea.onchange=function(){UpdateDescription(a, this.value);}
                }
            }

            //變更為新ID
            SelectedPhoto[a].ID=a;
        }

        //PrintSelectedPhoto();
    }

    //處理圖片選擇
    function OnPhotoChange(InputElement){
        const Files=InputElement.files;
        console.log("新選取了 "+Files.length+" 張照片");

        //儲存到變數
        //SelectedPhoto.concat(Files);

        for(let a=0;a<Files.length;a++){
            let SelectedPhotoAmount=SelectedPhoto.length;

            console.log("加入第 "+(SelectedPhotoAmount+1)+" 張照片");

            //取新的GUID作為PhotoID
            const PhotoID = crypto.randomUUID();
            //副檔名
            const PhotoType = GetFileExtension(Files[a].name);

            //儲存到變數
            SetSelectPhoto(SelectedPhotoAmount, PhotoID, PhotoType, "", Files[a]);

            // 使用 FileReader 讀取圖片
            const Reader=new FileReader();
            Reader.onloadend=function(E){
                //let PhotoNum=a;

                SetPhotoCard(SelectedPhotoAmount, E.target.result, "");

                SetPhotoFormData(SelectedPhotoAmount, PhotoID, PhotoType, "");
            }

            Reader.readAsDataURL(Files[a]); // 讀取圖片為 Data URL
        }

        //PrintSelectedPhoto();

        console.log("加入圖片完成");
    }

    //設置圖片顯示
    function SetPhotoCard(ID, PhotoSrc, Description){
        const Card=document.createElement("div");
        Card.className="card mt-1 mb-1 ms-1 me-1";
        Card.style.maxWidth = "18rem";
        Card.style.padding="0px";
        Card.style.overflow="hidden";
        Card.id = GetPhotoCardID(ID);

        Card.innerHTML=`
            <img src="/lib/bootstrap/Icon/arrows-move.svg" class="position-absolute top-0 end-0" style="width: 2rem; height: 2rem;"/>
            <img class="card-img-top" src="${PhotoSrc}" alt="Card image cap">
            <div class="card-body">
                <textarea name="VisitsPhotos[${ID}].Description" class="w-100" rows="10" onchange="UpdateDescription(${ID}, this.value)" placeholder="照片說明">${Description==null?"":Description}</textarea>
            </div>
            <div class="card-footer text-center">
                <button type="button" class="btn btn-outline-primary" onclick="RemovePhoto(${ID}, this)">刪除</button>
            </div>
        `;
        /*
            1.	${this.value} 的問題：
                •	this.value 是 JavaScript 的屬性，但在 HTML 中直接使用 ${} 是模板字串語法，這只在 JavaScript 中有效。
                •	在 HTML 中，${this.value} 不會被解析為 JavaScript 表達式，而是被當作普通字串處理，導致傳遞的值為 undefined。
            2.	作用域問題：
                •	this 在 onchange 中應該指向觸發事件的 <textarea> 元素，但因為模板字串語法錯誤，this 並未正確解析。
        */

        PhotoContainer.appendChild(Card);
    }

    //設置表單內圖片資料
    function SetPhotoFormData(ID, PhotoID, PhotoType, Description){
        // const FormData = document.createElement("div");
        // FormData.id = GetPhotoFormDataID(ID);
        // FormData.innerHTML = `
        //     <input name="VisitsPhotos[${ID}].MemberID" class="form-control" value="@ViewBag.MemberID" />
        //     <input name="VisitsPhotos[${ID}].PhotoID" class="form-control" value="${PhotoID}" />
        //     <input name="VisitsPhotos[${ID}].PhotoType" class="form-control" value="${PhotoType}" />
        //     <textarea name="VisitsPhotos[${ID}].Description" class="form-control">${Description}</textarea>
        // `;

        // PhotoForm.appendChild(FormData);
    }

    //紀錄選取的照片
    function SetSelectPhoto(ID, PhotoID, PhotoType, Description, File){
        SelectedPhoto.push({
            ID: ID,
            PhotoID: PhotoID,
            PhotoType: PhotoType,
            Description: Description,
            File:File
        });

        // console.log("已紀錄 "+SelectedPhoto.length+" 張照片");
        // for(let a=0;a<SelectedPhoto.length;a++){
        //     console.log("第 "+(a+1)+" 張照片 : "+SelectedPhoto[a].name);
        // }
    }

    function PrintSelectedPhoto(){
        //console.log("已紀錄 "+SelectedPhoto.length+" 張照片");
        for(let a=0;a<SelectedPhoto.length;a++){
            console.log(
                `${a} ID : ${SelectedPhoto[a].ID}, File : ${SelectedPhoto[a].File ? SelectedPhoto[a].File.name : "null"}`);
        }
    }

    //送出表單
    function SendForm(){
        //驗證失敗，表單不送出
        if(!$('#DataForm').valid()){
            console.log("表單驗證失敗");
            return;
        }

        //建立表單物件
        const FormDataObj=new FormData();

        //將原表單資料加入FormData
        const FormElements=$('#DataForm').serializeArray();
        FormElements.forEach(Element=>{
            //console.log(`Name : ${Element.name}, Value : ${Element.value}`);
            FormDataObj.append(Element.name, Element.value);
        });

        //將SelectedPhoto中的每個File加入FormData
        console.log("SelectedPhoto 數量 : "+SelectedPhoto.length);
        if(SelectedPhoto.length>0){
            // let VisitPhotosFormData = document.createElement("div");
            // VisitPhotosFormData.className="form-group";

            for(let a=0;a<SelectedPhoto.length;a++){
                //let PhotoData=document.createElement("div");

                FormDataObj.append(`VisitPhotos[${a}].PhotoID`, SelectedPhoto[a].PhotoID);
                FormDataObj.append(`VisitPhotos[${a}].PhotoType`, SelectedPhoto[a].PhotoType);
                FormDataObj.append(`VisitPhotos[${a}].Description`, SelectedPhoto[a].Description);
                // if(SelectedPhoto[a].File){
                //     PhotoData.append(`VisitPhotos[${a}].UploadFile`, SelectedPhoto[a].File);
                // }

                // PhotoData.innerHTML = `
                //     <input name="VisitPhotos[${a}].PhotoID" class="form-control" value="${SelectedPhoto[a].PhotoID}" />
                //     <input name="VisitPhotos[${a}].PhotoType" class="form-control" value="${SelectedPhoto[a].PhotoType}" />
                //     <textarea name="VisitsPhotos[${a}].Description" class="form-control">${SelectedPhoto[a].Description}</textarea>
                // `;
                // PhotoData.append(`<input name="VisitPhotos[${a}].PhotoID" class="form-control" value="${SelectedPhoto[a].PhotoID}" />`);
                // PhotoData.append(`<input name="VisitPhotos[${a}].PhotoType" class="form-control" value="${SelectedPhoto[a].PhotoType}" />`);
                // PhotoData.append(`<textarea name="VisitsPhotos[${a}].Description" class="form-control">${SelectedPhoto[a].Description}</textarea>`);

                if(SelectedPhoto[a].File){
                    //如果有實際的檔案，則加入到 PhotoData 內
                    FormDataObj.append(`VisitPhotos[${a}].UploadFile`, SelectedPhoto[a].File);
                    //PhotoData.append(`<input name="VisitPhotos[${a}].PhotoType" class="form-control" value="${SelectedPhoto[a].PhotoType}" />`);
                }

                //VisitPhotosFormData.append(PhotoData);
            }

            //FormDataObj.append("VisitPhotos", VisitPhotosFormData);
        }

        //印出FormDataObj
        // for (let pair of FormDataObj.entries()) {
        //     // 如果是檔案，顯示檔名；否則顯示值
        //     if (pair[1] instanceof File) {
        //         console.log(pair[0], pair[1].name);
        //     } else {
        //         console.log(pair[0], pair[1]);
        //     }
        // }

        //使用Ajax送出表單
        $.ajax({
            type:"post",
            url:"/Visits/@ViewData["FormAction"]",
            data:FormDataObj,
            processData: false, // 不處理資料，讓 FormData 自行處理
            contentType: false, // 不設置 Content-Type，讓瀏覽器自動處理
            success:function(){
                console.log("表單送出成功");

                //使用的是 AJAX 提交表單，伺服器返回的 RedirectToAction 不會自動在前端執行重導向。
                //需要在 AJAX 的 success 回呼中手動處理重導向。
                window.location.href = `/Visits/@ViewData[ViewDataKeys.AJAXAction]?Page=@ViewData[ViewDataKeys.LastPage]&MapDataParam=@MapData`;
            },
            error:function(xhr, status, error){
                console.log(`表單送出失敗 狀態碼 : ${xhr.status}, 錯誤狀態 : ${status}, 錯誤訊息 : ${error}, 伺服器回應 : ${xhr.responseText}`);

                //彈出錯誤訊息
                alert("操作失敗");
            }
        });
    }
</script>