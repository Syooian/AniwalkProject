@using AniwalkServer.Data
@model AniwalkServer.Models.Visits

<!-- 隱藏的文件選擇器 -->
<!--如果 event 被標示為已淘汰，建議在函式中明確地傳遞事件物件，並避免依賴全域的 event 物件 (更安全且現代的做法)-->
<!--所有圖片類型：image/*-->
<input type="file" class="form-control" accept=".jpg,.jpeg,.png,.jfif,.bmp,.gif" multiple id="PhotoPicker" hidden onchange="OnPhotoChange(this)" />
<!-- 新增照片按鈕 -->
<button type="button" class="btn btn-primary" onclick="OpenPhotoPicker()">
    新增照片
</button>
<span class="text-danger">@ViewData["PhotoError"]</span>

@{
    //將後端傳來的圖片資料經由Json傳給前端
    var PhotoListJson = "[]";
    /*
     * var PhotoListJson= "";
     * 這樣輸出的是「物件」而不是「字串」，所以 PhotoListJson 必須是合法的 JSON，不能是空字串，否則會造成 JS 錯誤。
     */
    @if (Model != null && Model.VisitsPhotos != null)
    {
        PhotoListJson = System.Text.Json.JsonSerializer.Serialize(
            Model.VisitsPhotos.Select(PhotoListJson => new
            {
                PhotoID = PhotoListJson.PhotoID,
                PhotoType = PhotoListJson.PhotoType,
                PhotoSrc = $"/{Shared.VisitsPhotosRootPath}/{Model.MemberID}/{PhotoListJson.PhotoID}{PhotoListJson.PhotoType}",
                Description = PhotoListJson.Description
            })
        );
    }

    string MapData = Shared.GetMapDataJsonEscapeDataString(ViewData);//PartialView不會抓到主頁的變數，所以要再做一次
}

@*顯示所有圖片Card的容器*@
<div class="row justify-content-center" id="PhotoContainer">
</div>

<script>
    //下方顯示所有圖片Card的容器
    const PhotoContainer = document.getElementById("PhotoContainer");
    //表單內容納所有圖片說明和資訊的容器
    const PhotoForm=document.getElementById("PhotoForm");
    //隱藏的圖片選擇器
    const PhotoPicker=document.getElementById("PhotoPicker");

    //儲存所有選取的圖片資料 (Map，類似C#的Dictionary，Key是PhotoID)
    let SelectedPhoto={};

    //初始化圖片顯示和既有圖片資料插入表單
    function InitPhotoContainer(){
        //從後端傳遞的圖片資料
        const Json=@Html.Raw(PhotoListJson);

        if(Json!=null)
        {
            //console.log(Json);

            for(let a=0;a<Json.length;a++)
            {
                //資料用Card顯示
                SetPhotoCard(Json[a].PhotoID, Json[a].PhotoSrc, Json[a].Description);

                //將資料加入到紀錄陣列中，如果模型傳來時已有圖片，也將其加入已選取檔案陣列
                SetSelectPhoto(Json[a].PhotoID, a, Json[a].PhotoType, Json[a].Description, null); //這裡的 null 代表沒有實際的 File 物件，因為這是從後端載入的資料
            }

            //PrintSelectedPhoto();

            //兩張圖片以上才能拖曳
            if(Json.length>2){
                SortablePhoto();
            }
        }
        else
        {
            console.log("沒有圖片資料");
        }
    }
    InitPhotoContainer();

    //啟用拖曳
    function SortablePhoto(){
        //console.log("SortablePhoto");

        //PhotoContainer 是 DOM 物件，不能直接呼叫。應該直接用 jQuery 選擇器：
        $("#PhotoContainer").sortable({
            items: ".card",//只針對Card
            cursor: "move",
            revert: true,
            placeholder: "sortable-placeholder",
            update: function(Event, UI){
                // 拖曳結束後可在這裡取得新順序
                console.log(`被拖曳的Card PhotoID : ${UI.item.attr('id')}, 新順序 : ${UI.item.index()}`);

                //RecalculateCardOrder();

                //修改圖片順序
                SelectedPhoto[UI.item.attr('id')].OrderID=UI.item.index();
            }
        });
    }

    //重新計算卡片的排列順序
    function RecalculateCardOrder(){
        let NewOrder=[];
        $("#PhotoContainer .card").each(function(){
            NewOrder.push(this.id);
        });

        for(let a=0;a<NewOrder.length;a++){
            console.log("New Order "+a+" : "+NewOrder[a]);
        }

        PrintSelectedPhoto();
    }

    //開啟文件選擇器
    function OpenPhotoPicker(){
        PhotoPicker.click();
    }

    //獲取檔案副檔名
    function GetFileExtension(FileName) {
        const Extension=FileName.split('.');
        return "."+Extension[Extension.length-1].toLowerCase();
    }

    //更新圖片說明
    function UpdateDescription(PhotoID, Value){
        SelectedPhoto[PhotoID].Description=Value;
    }

    // 刪除圖片
    function RemovePhoto(PhotoID, ButtonElement) {
        //console.log("刪除圖片 "+PhotoID);

        //刪除照片選擇的圖片
        /*
        1.	HTML 的 <input type="file"> 元素特性：
            •	一旦檔案被選擇，無法直接從 JavaScript 中刪除特定的檔案，因為 FileList 是唯讀的。
            •	解決方法是清空整個 PhotoSelecter 的值，然後重新管理已選擇的檔案。
        2.	解決方案：
            •	使用一個全域變數（如 selectedFiles）來儲存使用者選擇的檔案。
            •	當使用者刪除某個檔案時，從該變數中移除對應的檔案，並更新顯示。
        */
       /*
        filter：SelectedPhoto = SelectedPhoto.filter(photo => photo.ID !== ID);
            •	會建立一個新的陣列，包含所有符合條件的項目。在這裡，所有 photo.ID 不等於 ID 的項目，達到移除的效果。
        splice：const index = SelectedPhoto.findIndex(photo => photo.ID === ID);
                        if (index !== -1) {
                            SelectedPhoto.splice(index, 1);
                        }
            •	直接修改原陣列，從指定的索引位置移除項目。需要先用 findIndex 找到目標項目的索引。
       */
       // let DeleteIndex=SelectedPhoto.findIndex(P=>P.ID===ID);
       // if(DeleteIndex!==-1){
       //     SelectedPhoto.splice(DeleteIndex, 1);//移除從索引 DeleteIndex 開始的 1 個項目。
       // }
       delete SelectedPhoto[PhotoID];

       //刪除Card
        const Card = ButtonElement.closest('.card');//往上找到最近的 .card 元素
        if(Card)
            Card.remove();

        //PrintSelectedPhoto();
    }

    //處理圖片選擇
    function OnPhotoChange(InputElement){
        const Files=InputElement.files;
        console.log("新選取了 "+Files.length+" 張照片");

        for(let a=0;a<Files.length;a++){
            console.log("第 "+(a+1)+" 張新照片");

            //取新的GUID作為PhotoID
            const PhotoID = crypto.randomUUID();
            //副檔名
            const PhotoType = GetFileExtension(Files[a].name);

            //儲存到變數
            SetSelectPhoto(PhotoID, GetSelectedPhotoCount(), PhotoType, "", Files[a]);

            // 使用 FileReader 讀取圖片
            const Reader=new FileReader();
            Reader.onloadend=function(E){
                //let PhotoNum=a;

                SetPhotoCard(PhotoID, E.target.result, "");
            }

            Reader.readAsDataURL(Files[a]); // 讀取圖片為 Data URL
        }

        //PrintSelectedPhoto();

        //console.log("加入圖片完成");
    }

    //設置圖片顯示
    function SetPhotoCard(PhotoID, PhotoSrc, Description){
        const Card=document.createElement("div");
        Card.className="card mt-1 mb-1 ms-1 me-1";
        Card.style.maxWidth = "18rem";
        Card.style.padding="0px";
        Card.style.overflow="hidden";
        Card.id = PhotoID;

        Card.innerHTML=`
            <img src="/lib/bootstrap/Icon/arrows-move.svg" class="position-absolute top-0 end-0" style="width: 2rem; height: 2rem;"/>
            <img class="card-img-top" src="${PhotoSrc}" alt="Card image cap">
            <div class="card-body">
                <textarea class="w-100" rows="10" onchange="UpdateDescription('${PhotoID}', this.value)" placeholder="照片說明">${Description==null?"":Description}</textarea>
            </div>
            <div class="card-footer text-center">
                <button type="button" class="btn btn-outline-primary" onclick="RemovePhoto('${PhotoID}', this)">刪除</button>
            </div>
        `;
        /*
            1.	${this.value} 的問題：
                •	this.value 是 JavaScript 的屬性，但在 HTML 中直接使用 ${} 是模板字串語法，這只在 JavaScript 中有效。
                •	在 HTML 中，${this.value} 不會被解析為 JavaScript 表達式，而是被當作普通字串處理，導致傳遞的值為 undefined。
            2.	作用域問題：
                •	this 在 onchange 中應該指向觸發事件的 <textarea> 元素，但因為模板字串語法錯誤，this 並未正確解析。
        */

        PhotoContainer.appendChild(Card);
    }

    //紀錄選取的照片
    function SetSelectPhoto(PhotoID, OrderID, PhotoType, Description, File){
        SelectedPhoto[PhotoID]={
            OrderID: OrderID,
            PhotoType: PhotoType,
            Description: Description,
            File:File
        };

        // console.log("已紀錄 "+SelectedPhoto.length+" 張照片");
        // for(let a=0;a<SelectedPhoto.length;a++){
        //     console.log("第 "+(a+1)+" 張照片 : "+SelectedPhoto[a].name);
        // }
    }

    //取得所有以選取圖片的數量
    function GetSelectedPhotoCount(){
        return Object.keys(SelectedPhoto).length;
    }

    function PrintSelectedPhoto(){
        //console.log("已紀錄 "+SelectedPhoto.length+" 張照片");
        // for(const Photo of Object.values(SelectedPhoto)){
        //     console.log(`PhotoID : ${Photo.PhotoID}, File : ${Photo.File ? Photo.File.name : "null"}`);
        // }
        for(const PhotoKey in SelectedPhoto){
            const Photo = SelectedPhoto[PhotoKey];
            console.log(`PhotoID : ${PhotoKey}, File : ${Photo.File ? Photo.File.name : "null"}`);
        }
    }

    //送出表單
    function SendForm(){
        //驗證失敗，表單不送出
        if(!$('#DataForm').valid()){
            console.log("表單驗證失敗");
            return;
        }

        //建立表單物件
        const FormDataObj=new FormData();

        //將原表單資料加入FormData
        const FormElements=$('#DataForm').serializeArray();
        FormElements.forEach(Element=>{
            //console.log(`Name : ${Element.name}, Value : ${Element.value}`);
            FormDataObj.append(Element.name, Element.value);
        });

        //將SelectedPhoto中的元素加入表單物件中
        //console.log("SelectedPhoto 數量 : "+SelectedPhoto.length);
        let ID=0;//順序ID
        //取得所有Photo資料並轉成陣列
        let PhotoArray=Object.entries(SelectedPhoto).map(([PhotoID, Data]) => ({PhotoID, Data}));
        //依順序排列
        PhotoArray.sort((a, b)=>a.OrderID-b.OrderID);

        for(const Photo in PhotoArray){
            FormDataObj.append(`VisitPhotos[${ID}].PhotoID`, Photo.PhotoID);
            FormDataObj.append(`VisitPhotos[${ID}].PhotoType`, Photo.PhotoType);
            FormDataObj.append(`VisitPhotos[${ID}].Description`, Photo.Description);

            if(Photo.File){
                //如果有實際的檔案，則加入到 PhotoData 內
                FormDataObj.append(`VisitPhotos[${ID}].UploadFile`, Photo.File);
            }

            ID++;
        }

        //使用Ajax送出表單
        $.ajax({
            type:"post",
            url:"/Visits/@ViewData["FormAction"]",
            data:FormDataObj,
            processData: false, // 不處理資料，讓 FormData 自行處理
            contentType: false, // 不設置 Content-Type，讓瀏覽器自動處理
            success:function(){
                console.log("表單送出成功");

                //使用的是 AJAX 提交表單，伺服器返回的 RedirectToAction 不會自動在前端執行重導向。
                //需要在 AJAX 的 success 回呼中手動處理重導向。
                window.location.href = `/Visits/@ViewData[ViewDataKeys.AJAXAction]?Page=@ViewData[ViewDataKeys.LastPage]&MapDataParam=@MapData`;
            },
            error:function(xhr, status, error){
                console.log(`表單送出失敗 狀態碼 : ${xhr.status}, 錯誤狀態 : ${status}, 錯誤訊息 : ${error}, 伺服器回應 : ${xhr.responseText}`);

                //彈出錯誤訊息
                alert("操作失敗");
            }
        });
    }
</script>