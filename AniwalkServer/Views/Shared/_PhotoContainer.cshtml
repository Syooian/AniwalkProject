                </div>
            </div>
        } *@
</div>

<script>
    //開啟圖片多選
    function OpenPhotoPicker(){
        document.getElementById("PhotoSelecter").click();
    }

    //處理圖片選擇
    function OnPhotoChange(InputElement){
        const Files=InputElement.files;
        console.log("選取了 "+Files.length+" 張照片");

        const PhotoContainer = document.getElementById("PhotoContainer");

        for(var a=0;a<Files.length;a++){
            console.log("處理第 "+(a+1)+" 張照片");

            // 使用 FileReader 讀取圖片
            const Reader=new FileReader();
            Reader.onloadend=function(E){
                const Card=document.createElement("div");
                Card.className="card mt-1 mb-1 ms-1 me-1";
                Card.style.maxWidth = "18rem";

                Card.innerHTML=`
                    <button type="button" class="btn btn-outline-primary" onclick="RemovePhoto(this)">刪除</button>
                    <img class="card-img-top" src="${E.target.result}" alt="Card image cap">
                    <div class="card-body">
                        <textarea class="form-control" rows="10"></textarea>
                    </div>
                `;

                PhotoContainer.appendChild(Card);
            }

            Reader.readAsDataURL(Files[a]); // 讀取圖片為 Data URL
        }

        console.log("圖片處理完成");
    }

        // 刪除圖片
    function RemovePhoto(ButtonElement) {
        const Card = ButtonElement.parentElement;
        Card.remove();
    }
</script>