@{
    var CurrentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var CurrentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
@{
    //共用Head
    await Html.RenderPartialAsync("_SharedLayout.Head");
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom mb-3 bg-info bg-opacity-25 shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AniwalkServer</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Visits" asp-action="ShowVisitsOnMap">地圖檢視</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Visits" asp-action="ShowVisitsOnList">清單檢視</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="AddNewAnimes" asp-action="Create">填寫新增動畫建議</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav text-end">
                        <li class="nav-item">
                            <div class="btn-group">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="DropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    歡迎，@User.Identity.Name
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="DropdownMenu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Members" asp-action="Details" asp-route-MemberID="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">個人資訊</a></li>
                                    <li><hr class="dropdown-divider"></li><!--分隔線-->
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Login" asp-action="Logout">登出</a></li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (CurrentController == "Visits" && CurrentAction == "ShowVisitsOnMap")
    {
        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AniwalkServer - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    @{
        //共用Scripts
        await Html.RenderPartialAsync("_SharedLayout.Scripts");
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
